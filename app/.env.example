# Copy to .env and fill in. These are public client keys (safe in the app).
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Google Maps Platform key with "Places API (New)" enabled.
# Restrict it to your app (Android/iOS bundle id, web domain) in Google Cloud.
EXPO_PUBLIC_GOOGLE_MAPS_KEY=your-google-maps-key
